# PostgreSQL
DB_PASSWORD=

# RabbitMQ
RABBITMQ_USER=marketplace
RABBITMQ_PASSWORD=
RABBITMQ_HOSTNAME=rabbitmq

# Keycloak
KEYCLOAK_VERSION=26.8.2
KC_PASSWORD=
KEYCLOAK_PUBLIC_URL=http://localhost:8081

# Frontend
FRONTEND_PUBLIC_URL=http://localhost:5173

# Internal service authentication
PAYMENT_INTERNAL_KEY=

# License Vault
LICENSE_ENCRYPTION_KEY=
LICENSE_FINGERPRINT_KEY=

# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# Notification Service
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Digital License Marketplace"

# Codespaces Auth Proxy
KEYCLOAK_PUBLIC_HOST=

# Optional Jira Service Management integration
JIRA_WEBHOOK_SECRET=
JIRA_ENABLED=false
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SERVICE_DESK_ID=
JIRA_REQUEST_TYPE_ID=

# Kinguin Mock auto-import: ONLY for a dedicated local demo database.
# Never enable on a live store or a database containing real license stock.
KINGUIN_DEMO_AUTO_IMPORT=false
