{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/licenses/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "license-vault",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/licenses/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PATCH"]
    },
    {
      "DownstreamPathTemplate": "/api/products/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "catalog", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/catalog/products/{everything}",
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE"]
    },
    {
      "DownstreamPathTemplate": "/api/products",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "catalog", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/catalog/products",
      "UpstreamHttpMethod": ["GET", "POST"]
    },
    {
      "DownstreamPathTemplate": "/api/orders/vnpay-ipn",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "order", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/orders/vnpay-ipn",
      "UpstreamHttpMethod": ["GET"],
      "Priority": 1
    },
    {
      "DownstreamPathTemplate": "/api/orders/{id}/pay",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "order", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/orders/{id}/pay",
      "UpstreamHttpMethod": ["POST"]
    },
    {
      "DownstreamPathTemplate": "/api/orders/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "order", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/orders/{id}",
      "UpstreamHttpMethod": ["GET"]
    },
    {
      "DownstreamPathTemplate": "/api/orders",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "order", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/orders",
      "UpstreamHttpMethod": ["GET", "POST"]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000"
  }
}
