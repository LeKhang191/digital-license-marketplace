{
  "realm": "marketplace",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "customer", "description": "Khách hàng" },
      { "name": "admin", "description": "Quản trị viên" }
    ]
  },
  "clients": [
    {
      "clientId": "marketplace-web",
      "name": "Marketplace Web (React)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "Admin@123", "temporary": false }],
      "realmRoles": ["admin", "customer"]
    },
    {
      "username": "customer1",
      "enabled": true,
      "email": "customer1@example.com",
      "emailVerified": true,
      "firstName": "Customer",
      "lastName": "Demo",
      "credentials": [{ "type": "password", "value": "Customer@123", "temporary": false }],
      "realmRoles": ["customer"]
    }
  ]
}
