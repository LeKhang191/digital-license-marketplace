
{
  "realm": "marketplace",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Khách hàng"
      },
      {
        "name": "catalog_manager",
        "description": "Quản lý danh mục sản phẩm"
      },
      {
        "name": "license_coordinator",
        "description": "Điều phối kho mã bản quyền"
      },
      {
        "name": "transaction_auditor",
        "description": "Kiểm toán giao dịch và hoàn tiền"
      },
      {
        "name": "partner_api",
        "description": "Đối tác B2B tích hợp qua Partner API"
      },
      {
        "name": "admin",
        "description": "Legacy role - temporary compatibility"
      }
    ]
  },
  "defaultRoles": [
    "customer"
  ],
  "clients": [
    {
      "clientId": "marketplace-web",
      "name": "Marketplace Web (React)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
