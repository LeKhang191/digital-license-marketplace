# Bổ sung biến môi trường cho triển khai trực tiếp trên VPS bằng Nginx + Let's Encrypt
# (KHÔNG dùng Cloudflare). Sao chép các biến này vào file .env trên server (không commit .env).

# Kích hoạt overlay VPS cùng docker-compose.yml gốc
COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml

# Domain trỏ DNS A/AAAA trực tiếp về IP public của VPS
APP_DOMAIN=marketplace.example.com
AUTH_DOMAIN=auth.example.com
CERTBOT_EMAIL=admin@example.com

# URL công khai đồng bộ với APP_DOMAIN và AUTH_DOMAIN
FRONTEND_PUBLIC_URL=https://marketplace.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
VNPAY_RETURN_URL=https://marketplace.example.com/payment/result

# Tùy chọn đổi cổng host cho Nginx nếu homeserver đã có container khác chiếm 80/443
# (ví dụ discord_nginx của ChitNChat trên khenserver):
# NGINX_HTTP_BIND=127.0.0.1:8088
# NGINX_HTTPS_BIND=127.0.0.1:8443

# Partner Outbound Webhook (chỉ bật khi đích webhook nằm trên mạng nội bộ/Tailscale như khenserver)
# PARTNER_WEBHOOK_ALLOW_PRIVATE_NETWORK=false
# PARTNER_WEBHOOK_ALLOW_INSECURE_HTTP=false

# Frontend build (ghi vào frontend/.env.production trước khi chạy npm run build)
# VITE_API_URL=/api
# VITE_KEYCLOAK_URL=https://auth.example.com
# VITE_KEYCLOAK_REALM=marketplace
# VITE_KEYCLOAK_CLIENT_ID=marketplace-web
