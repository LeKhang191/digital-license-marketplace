# Cấu hình Nginx phía sau Tailscale Funnel (TLS được Tailscale kết thúc ở cổng 443,
# chuyển tiếp HTTP nội bộ về 127.0.0.1:8088).
# Dùng chung 1 hostname công khai (${PUBLIC_HOST}) nhưng phân tách hoàn toàn path:
#   - /api/orders/vnpay-ipn        -> Gateway (GET only, rate-limit, access_log off)
#   - /api/support/webhooks/jira   -> Gateway (POST only, max 16KB, rate-limit, access_log off)
#   - /api/partner/*               -> Gateway (rate-limit riêng 20r/s, tắt log ở /licenses/claim)
#   - /api/*                       -> Gateway (API chung, max 10MB cho upload CSV/TXT)
#   - /realms/marketplace/*, /resources/*, /js/* -> Keycloak OIDC/Google Broker
#   - /realms/master               -> 403 Forbidden (chặn public)
#   - /* (bao gồm /admin của React SPA) -> Static frontend/dist (KHÔNG chạm Keycloak Admin)

limit_req_zone $binary_remote_addr zone=dlm_vnpay_ipn:2m rate=10r/s;
limit_req_zone $binary_remote_addr zone=dlm_jira_webhook:2m rate=5r/s;
limit_req_zone $binary_remote_addr zone=dlm_partner_api:5m rate=20r/s;
limit_req_zone $binary_remote_addr zone=dlm_api:10m rate=30r/s;

server {
    listen 80 default_server;
    server_name _;

    server_tokens off;
    resolver 127.0.0.11 valid=10s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Chặn hoàn toàn master realm của Keycloak từ Internet
    location ^~ /realms/master {
        return 403;
    }

    # VNPay Sandbox/Production IPN (chỉ GET, giữ nguyên query string, không ghi log query chứa hash)
    location = /api/orders/vnpay-ipn {
        if ($request_method != GET) {
            return 405;
        }

        limit_req zone=dlm_vnpay_ipn burst=20 nodelay;
        limit_req_status 429;
        access_log off;

        set $gateway_upstream http://gateway:8080;
        proxy_pass $gateway_upstream/api/orders/vnpay-ipn$is_args$args;
        proxy_http_version 1.1;

        proxy_set_header Host gateway;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 15s;
    }

    # Jira Service Management Automation Webhook (chỉ POST, giới hạn payload, forward secret header)
    location = /api/support/webhooks/jira {
        if ($request_method != POST) {
            return 405;
        }

        client_max_body_size 16k;
        client_body_timeout 10s;

        limit_req zone=dlm_jira_webhook burst=10 nodelay;
        limit_req_status 429;
        access_log off;

        set $gateway_upstream http://gateway:8080;
        proxy_pass $gateway_upstream/api/support/webhooks/jira;
        proxy_http_version 1.1;

        proxy_set_header Host gateway;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-DLM-Webhook-Secret $http_x_dlm_webhook_secret;

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 15s;
    }

    # Partner B2B API claim key (tắt access_log)
    location ~ ^/api/partner/v1/orders/[^/]+/licenses/claim$ {
        if ($request_method != POST) {
            return 405;
        }

        limit_req zone=dlm_partner_api burst=20 nodelay;
        limit_req_status 429;
        access_log off;

        set $gateway_upstream http://gateway:8080;
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 15s;
    }

    # Partner B2B API chung
    location /api/partner/ {
        limit_req zone=dlm_partner_api burst=40 nodelay;
        limit_req_status 429;
        client_max_body_size 256k;

        set $gateway_upstream http://gateway:8080;
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};

        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 15s;
    }

    # API chung chuyển vào Ocelot Gateway (hỗ trợ upload CSV/TXT nhập kho tối đa 10MB)
    location /api/ {
        limit_req zone=dlm_api burst=60 nodelay;
        limit_req_status 429;
        client_max_body_size 10m;

        set $gateway_upstream http://gateway:8080;
        proxy_pass $gateway_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
    }

    # Keycloak public OIDC/OAuth2 + Google Broker endpoints (KHÔNG bao gồm /admin)
    location ~ ^/(realms/marketplace(/|$)|resources/|js/) {
        set $keycloak_upstream http://keycloak:8080;
        proxy_pass $keycloak_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Prefix "";

        # Keycloak + Google OAuth sinh header/cookie lớn
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    # Static assets sinh ra bởi Vite build
    root /usr/share/nginx/html;
    index index.html;

    location ^~ /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback cho React Router (bao gồm /admin của Catalog Manager)
    location / {
        try_files $uri $uri/ /index.html;
    }
}
