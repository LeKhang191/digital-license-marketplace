<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PaymentService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Contracts\Contracts.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Compile Include="../../shared/Infrastructure/Security/KeycloakAuthentication.cs" Link="Shared/Security/KeycloakAuthentication.cs" />
    <Compile Include="../../shared/Infrastructure/Security/InternalServiceAuth.cs" Link="Shared/Security/InternalServiceAuth.cs" />
    <Compile Include="../../shared/Infrastructure/Messaging/RabbitMqPublisher.cs" Link="Shared/Messaging/RabbitMqPublisher.cs" />
  </ItemGroup>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);PAYMENT_SERVICE</DefineConstants>
  </PropertyGroup>


  <ItemGroup>
    <Compile Include="../../shared/Infrastructure/Messaging/OutboxLoop.cs"
             Link="Shared/Messaging/OutboxLoop.cs" />
    <Compile Include="../../shared/Infrastructure/Messaging/RetryDelay.cs"
             Link="Shared/Messaging/RetryDelay.cs" />
  </ItemGroup>

</Project>
