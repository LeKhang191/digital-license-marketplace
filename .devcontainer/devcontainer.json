{
  "name": "Digital License Marketplace",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    5173,
    8000,
    8081,
    15672,
    8002
  ],
  "portsAttributes": {
    "5173": {
      "label": "React Frontend",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "API Gateway",
      "onAutoForward": "notify"
    },
    "8081": {
      "label": "Keycloak",
      "onAutoForward": "notify"
    },
    "15672": {
      "label": "RabbitMQ",
      "onAutoForward": "silent"
    },
    "8002": {
      "label": "Jira Webhook",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode",
  "postStartCommand": "bash scripts/fix-codespaces-network.sh --if-running"
}
